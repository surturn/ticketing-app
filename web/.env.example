# Firebase web app config.
#
# These are NOT secrets. Every value here is compiled into the browser bundle and
# is visible to anyone who opens devtools — that is how the Firebase web SDK is
# designed to work. What protects the project is not hiding these, it is the
# authorised-domains list, the sign-in providers you enable, and (for Firestore or
# Storage, if ever used) the security rules. The real secret is the service-account
# key, which lives in the API's own .env and never appears here.
#
# Copy to .env and fill in from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration
#
# Note that Vite inlines these at BUILD time, not at run time. A deploy that
# builds without them produces a bundle that cannot sign anyone in, so they must
# be present in the build environment — not just on the running server.
#
# Only VITE_-prefixed variables are exposed to client code.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Analytics is only initialised when this is set, and only in a browser.
# Leave blank until you have decided how you are handling cookie consent.
VITE_FIREBASE_MEASUREMENT_ID=
