# ─── Server ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated origins allowed to call the public API.
# Your event sites go here, e.g. https://event.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Postgres ────────────────────────────────────────────────────────
DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=10

# Set to `transaction` if PgBouncer/Supavisor sits in front of Postgres in
# transaction pooling mode. This disables prepared statements; without it you
# get intermittent `prepared statement "s1" already exists` under load.
# one of: none | session | transaction
DATABASE_POOLER_MODE=none

# Fail a contended row lock fast rather than holding a pooled connection
# hostage and starving the pool during a flash sale.
DATABASE_LOCK_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ─── Redis (cache + BullMQ queues) ───────────────────────────────────
REDIS_URL=redis://localhost:6379
# Namespace prefix so cache keys and queues can share one Redis instance.
REDIS_PREFIX=ticketing
# Default TTL for cached read responses, in seconds.
CACHE_TTL_SECONDS=30
# Set false to bypass the cache entirely (reads go straight to Postgres).
CACHE_ENABLED=true

# ─── Secrets ─────────────────────────────────────────────────────────
# Long random string. Signs the QR payload on every issued ticket.
# Rotating this invalidates all previously issued QR codes.
TICKET_SIGNING_SECRET=

# Long random string. Signs short-lived scanner (gate staff) JWTs.
SCANNER_JWT_SECRET=

# Admin API key, sent as the `x-api-key` header on administrative requests.
ADMIN_API_KEY=

# ─── Checkout behaviour ──────────────────────────────────────────────
# How long a seat is held while the buyer completes payment.
ORDER_HOLD_MINUTES=10

# Days after an event finishes before it moves from the current listing into
# past events. Archiving is reversible and deletes nothing.
EVENT_ARCHIVE_AFTER_DAYS=2
# Run BullMQ workers inside the API process instead of a separate one.
# Fine for a single small deployment; use `npm run start:worker` in production.
RUN_WORKERS_IN_API=false
# Worker concurrency per queue.
WORKER_CONCURRENCY=5

# ─── M-Pesa Daraja ───────────────────────────────────────────────────
# sandbox | production
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=

# The shortcode the passkey was issued against. This is what signs the request.
# For Buy Goods/Till setups this is usually the head-office (store) number,
# NOT the Till itself. 174379 is the sandbox Paybill.
MPESA_SHORTCODE=174379

# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till.
# Getting this wrong makes every single STK push fail.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# The shortcode funds actually credit — your Till number for Buy Goods.
# Leave blank when it is the same as MPESA_SHORTCODE (the Paybill case).
MPESA_PARTY_B=

# Public HTTPS URL of this service's M-Pesa callback. The required path is fixed
# and validated at startup, which will tell you the exact value if this is wrong.
# See the internal integration notes.
MPESA_CALLBACK_URL=
# Shared secret appended to the callback URL as a query parameter, so unsolicited
# traffic is rejected. Leave blank to disable the check.
MPESA_CALLBACK_TOKEN=

# ─── M-Pesa B2C and Reversal (optional) ──────────────────────────────
# These move money OUT of the shortcode: B2C pays an organiser their takings,
# Reversal refunds a buyer. Leave blank and the service sells tickets exactly as
# before — only these two products are unavailable.
#
# The initiator is an API operator created under the shortcode in the Daraja
# portal, with the Business Payment and Reversal roles assigned. It is not the
# shortcode itself. The password is never transmitted: it is RSA-encrypted
# against Safaricom's public certificate to form SecurityCredential.
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=

# Safaricom's public certificate for this environment, downloaded from the
# Daraja portal. Sandbox and production are different files and are not
# interchangeable. Relative to the repo root; certs/ is gitignored.
MPESA_INITIATOR_CERT_PATH=certs/SandboxCertificate.cer

# BusinessPayment is correct for paying an organiser out.
MPESA_B2C_COMMAND=BusinessPayment

# ─── Firebase (optional buyer accounts) ──────────────────────────────
# Leave blank to run without accounts. Guest checkout is unaffected either way;
# account endpoints simply return 503.
#
# All three come from a service-account JSON key. That key is effectively full
# project admin — keep it in the platform's env store, never in the repo.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The full PEM key. Newlines may be written as \n escapes, and surrounding
# quotes are stripped, so the value can be pasted straight from the JSON file.
FIREBASE_PRIVATE_KEY=

# ─── Brevo (transactional email) ─────────────────────────────────────
# Without these the notification worker logs what it would have sent rather
# than failing, so a missing key never blocks a sale.
BREVO_API_KEY=
# Must be a sender you have verified in Brevo, or every send is rejected.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tickets

# Public site buyers use to view an order; used to build the receipt link.
#   e.g. https://event.example.com  →  https://event.example.com/orders/TKT-...
PUBLIC_ORDER_BASE_URL=
